<canvas
  id="sort"
  width="600"
  height="400"
></canvas>

<script type="module">
  import { renderMergeSortAnimation } from "@/scripts/mergeSort";
  import { generateRandomArray } from "@/scripts/generateRandomArray";
  const canvas = document.getElementById("sort");

  if (canvas instanceof HTMLCanvasElement) {
    const array = generateRandomArray(100, 1, 100);

    renderMergeSortAnimation(canvas, array);
  }
</script>